# Reverse proxy con certificato HTTPS automatico (Let's Encrypt).
# Il dominio arriva dalla variabile DOMAIN del file .env.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# limite di dimensione delle richieste (file di importazione inclusi)
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# API e interfaccia sulla stessa origine: cookie di sessione semplici, nessun CORS
	handle /api/* {
		reverse_proxy api:4000
	}

	# risorse statiche dell'interfaccia: nomi con hash, cache lunga
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}
}

# il dominio con www rimanda a quello principale (se configurato nel DNS)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
