# Configurazione di produzione. Copia in deploy/.env e compila.
# Il file .env contiene segreti: non va mai caricato su GitHub (è già escluso da .gitignore).

# Dominio pubblico, senza https:// (deve già puntare all'indirizzo IP del server)
DOMAIN=foodcost.esempio.it

# Email per il certificato HTTPS (avvisi di Let's Encrypt)
ACME_EMAIL=tecnico@esempio.it

# Password del database: lunga e casuale, per esempio generata con
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Server di posta per inviti e recupero password (consigliato).
# Senza SMTP l'app funziona: l'amministratore riceve il link d'invito da consegnare a mano.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Food Cost <no-reply@esempio.it>

# Facoltativi
SESSION_DAYS=14
LOGIN_RATE_LIMIT=10
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_RETENTION_DAYS=30
LOG_LEVEL=info
