{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./*"],
      "next/link": ["./shims/next-link.tsx"],
      "next/navigation": ["./shims/next-navigation.ts"],
      "@foodcost/domain": ["./packages/domain/index.ts"]
    }
  },
  "include": ["app", "components", "lib", "packages", "shims", "src"],
  "exclude": ["app/layout.tsx"]
}
