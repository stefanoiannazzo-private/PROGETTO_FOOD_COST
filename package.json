{
  "name": "food-cost",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/domain", "apps/api", "apps/web"],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "worker": "npm run worker -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "seed:demo": "npm run seed:demo -w apps/api",
    "test": "npm test -w packages/domain && npm test -w apps/api",
    "typecheck": "npm run typecheck -w packages/domain && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web"
  },
  "engines": { "node": ">=22" }
}
