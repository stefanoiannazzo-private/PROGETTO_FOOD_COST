# Food Cost — configurazione. Copia in .env e compila. NON inserire mai questo file con valori reali nel repository.
APP_NAME="Food Cost"
APP_ENV=local
# generata con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TZ=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=daily
LOG_LEVEL=debug

# MySQL 8 (in produzione: i dati del database dell'hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodcost
DB_USERNAME=foodcost
DB_PASSWORD=

# sessioni dell'app: tabella propria + cookie fc_session (questo valore riguarda solo Laravel)
SESSION_DRIVER=array
SESSION_DAYS=14
# true in produzione (solo HTTPS)
COOKIE_SECURE=false
# origini ammesse per le richieste che modificano dati, separate da virgola (in produzione: l'indirizzo del sito)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
LOGIN_RATE_LIMIT=10

# nessun worker permanente: i lavori in coda avanzano con le richieste e con il cron dell'hosting
CACHE_STORE=database
QUEUE_CONNECTION=sync
JOB_SLICE_SECONDS=4
# chiave lunga e casuale; l'hosting chiama https://<sito>/api/cron?k=<CRON_KEY> ogni 5 minuti. Vuota = disattivato
CRON_KEY=
# chiave per il passo finale del deploy automatico (migrazioni): vuota = disattivato
DEPLOY_KEY=

IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_RETENTION_DAYS=30

# email (inviti e recupero password). Con "log" i messaggi finiscono in storage/app/outbox e il link è mostrato a chi invita
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Food Cost"

# solo sviluppo: mostra i link di invito/reset nelle risposte (ignorato con APP_ENV=production)
DEV_EXPOSE_TOKENS=false
