# Copia in apps/api/.env e adatta. Nessuna credenziale reale nel repository.

# Database: PostgreSQL server...
# DATABASE_URL=postgres://foodcost:foodcost@localhost:5432/foodcost
# ...oppure PostgreSQL in-process su file, senza server (solo sviluppo locale)
DATABASE_URL=pglite:./.data/dev

PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_TZ=Europe/Rome

# true in produzione dietro HTTPS
COOKIE_SECURE=false
SESSION_DAYS=14
LOGIN_RATE_LIMIT=10

# File privati (importazioni, email di sviluppo in storage/outbox)
STORAGE_DIR=./storage
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_RETENTION_DAYS=30

# Solo sviluppo locale: mostra i link di invito/reset nella risposta API
DEV_EXPOSE_TOKENS=false
